    togglePin.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    togglePin.BorderSizePixel = 0

    local pinCorner = Instance.new("UICorner", togglePin)
    pinCorner.CornerRadius = UDim.new(1, 0)

    local toggled = false
    toggleBG.MouseButton1Click:Connect(function()
        toggled = not toggled
        local targetPos = toggled and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
        local targetColor = toggled and Color3.fromRGB(255, 220, 0) or Color3.fromRGB(45, 45, 48) -- FIXED: Yellow toggle
        
        TweenService:Create(togglePin, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Position = targetPos}):Play()
        TweenService:Create(toggleBG, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {BackgroundColor3 = targetColor}):Play()
        
        if callback then callback(toggled) end
    end)

    return container
end

