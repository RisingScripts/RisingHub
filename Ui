local function addSliderWidget(parentPage, titleText, minVal, maxVal, defaultVal, callback)
    titleText = titleText or "New Slider"
    minVal = minVal or 0
    maxVal = maxVal or 100
    defaultVal = defaultVal or 50

    local container = Instance.new("Frame", parentPage)
    container.Name = "SliderContainer"
    container.Size = UDim2.new(1, -10, 0, 50)
    container.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    container.BackgroundTransparency = 0.5
    container.BorderSizePixel = 0
    
    local containerCorner = Instance.new("UICorner", container)
    containerCorner.CornerRadius = UDim.new(0, 8)

    local titleLabel = Instance.new("TextLabel", container)
    titleLabel.Size = UDim2.new(0, 160, 0, 18)
    titleLabel.Position = UDim2.new(0, 12, 0, 16)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = titleText
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLabel.TextSize = 13
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left

    local sliderTrack = Instance.new("TextButton", container)
    sliderTrack.Name = "SliderTrack"
    sliderTrack.Size = UDim2.new(0, 110, 0, 4)
    sliderTrack.Position = UDim2.new(1, -150, 0.5, -2)
    sliderTrack.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
    sliderTrack.Text = ""
    sliderTrack.AutoButtonColor = false
    sliderTrack.BorderSizePixel = 0

    local trackCorner = Instance.new("UICorner", sliderTrack)
    trackCorner.CornerRadius = UDim.new(1, 0)

    local sliderFill = Instance.new("Frame", sliderTrack)
    sliderFill.Size = UDim2.new(0, 0, 1, 0)
    sliderFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    sliderFill.BorderSizePixel = 0
    Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(1, 0)

    local sliderKnob = Instance.new("Frame", sliderTrack)
    sliderKnob.Name = "Knob"
    sliderKnob.Size = UDim2.new(0, 10, 0, 10)
    sliderKnob.Position = UDim2.new(0, -5, 0.5, -5)
    sliderKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    sliderKnob.BorderSizePixel = 0
    Instance.new("UICorner", sliderKnob).CornerRadius = UDim.new(1, 0)

    local valLabel = Instance.new("TextLabel", container)
    valLabel.Size = UDim2.new(0, 30, 0, 16)
    valLabel.Position = UDim2.new(1, -35, 0.5, -8)
    valLabel.BackgroundTransparency = 1
    valLabel.Text = tostring(defaultVal)
    valLabel.Font = Enum.Font.GothamMedium
    valLabel.TextColor3 = Color3.fromRGB(220, 220, 225)
    valLabel.TextSize = 11
    valLabel.TextXAlignment = Enum.TextXAlignment.Right

    local sliderActive = false
    local function updateSlider(input)
        local relativeX = input.Position.X - sliderTrack.AbsolutePosition.X
        local percentage = math.clamp(relativeX / sliderTrack.AbsoluteSize.X, 0, 1)
        
        sliderKnob.Position = UDim2.new(percentage, -5, 0.5, -5)
        sliderFill.Size = UDim2.new(percentage, 0, 1, 0)
        
        local snapValue = math.floor(minVal + (percentage * (maxVal - minVal)))
        valLabel.Text = tostring(snapValue)
        
        if callback then callback(snapValue) end
    end

    sliderTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliderActive = true
            updateSlider(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if sliderActive and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateSlider(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliderActive = false
        end
    end)

    local initPercent = math.clamp((defaultVal - minVal) / (maxVal - minVal), 0, 1)
    sliderKnob.Position = UDim2.new(initPercent, -5, 0.5, -5)
    sliderFill.Size = UDim2.new(initPercent, 0, 1, 0)

    return container
end

