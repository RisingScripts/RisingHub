local activeWindow = nil
local windows = {}
local tabs = {}

local function createMenuPart(name, layoutOrder)
    local page = Instance.new("ScrollingFrame", windowCanvas)
    page.Name = name .. "Page"
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255)
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.ClipsDescendants = false 
    
    local layout = Instance.new("UIListLayout", page)
    layout.Padding = UDim.new(0, 12)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    
    windows[name] = page
    tabs[name] = true
    
    local tabBtn = Instance.new("TextButton", navBar)
    tabBtn.Name = name .. "Tab"
    tabBtn.Size = UDim2.new(0, 84, 0, 28) 
    tabBtn.BackgroundColor3 = Color3.fromRGB(255, 220, 0) -- FIXED: Vibrant Yellow Accent Box
    tabBtn.BackgroundTransparency = 1 -- Transparent until active/hovered
    tabBtn.Text = name
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextSize = 12
    tabBtn.TextColor3 = Color3.fromRGB(200, 200, 205)
    tabBtn.LayoutOrder = layoutOrder
    tabBtn.BorderSizePixel = 0
    tabBtn.AutoButtonColor = false
    
    local tabCorner = Instance.new("UICorner", tabBtn)
    tabCorner.CornerRadius = UDim.new(0, 6)
    
    tabBtn.MouseEnter:Connect(function()
        if activeWindow ~= name then
            TweenService:Create(tabBtn, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
                BackgroundTransparency = 0.6,
                TextColor3 = Color3.fromRGB(255, 255, 255)
            }):Play()
        end
    end)
    
    tabBtn.MouseLeave:Connect(function()
        if activeWindow ~= name then
            TweenService:Create(tabBtn, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
                BackgroundTransparency = 1,
                TextColor3 = Color3.fromRGB(200, 200, 205)
            }):Play()
        end
    end)
    
    tabBtn.MouseButton1Click:Connect(function()
        if activeWindow == name then return end
        
        for _, obj in ipairs(screenGui:GetChildren()) do
            if obj.Name == "CustomDropdownMenu" then obj:Destroy() end
        end
        
        if activeWindow then
            local oldPage = windows[activeWindow]
            oldPage.Visible = false
            local oldTab = navBar:FindFirstChild(activeWindow .. "Tab")
            if oldTab then
                TweenService:Create(oldTab, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
                    BackgroundTransparency = 1,
                    TextColor3 = Color3.fromRGB(200, 200, 205)
                }):Play()
            end
        end
        
        activeWindow = name
        page.Visible = true
        
        -- Fully engage Neon Yellow selection state
        TweenService:Create(tabBtn, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
            BackgroundTransparency = 0.15,
            TextColor3 = Color3.fromRGB(255, 255, 255)
        }):Play()
    end)
    
    return page
end

