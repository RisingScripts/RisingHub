local function AddSkeleton(char, folder)
    local function CreateL() 
        local l = Instance.new("Frame", folder); l.BorderSizePixel = 0; l.AnchorPoint = Vector2.new(0.5, 0.5); l.Visible = false; return l
    end
    
    -- Gelişmiş İskelet Parçaları
    local lines = {
        Spine = CreateL(), Neck = CreateL(),
        L_Shoulder = CreateL(), L_Arm = CreateL(), L_Hand = CreateL(),
        R_Shoulder = CreateL(), R_Arm = CreateL(), R_Hand = CreateL(),
        L_Hip = CreateL(), L_Leg = CreateL(), L_Foot = CreateL(),
        R_Hip = CreateL(), R_Leg = CreateL(), R_Foot = CreateL()
    }
    
    local skelConn
    skelConn = RunService.RenderStepped:Connect(function()
        if not char or not char.Parent then folder:Destroy(); skelConn:Disconnect(); return end
        if Settings.SkeletonEnabled and Settings.MasterEnabled then
            local function Draw(l, p1, p2)
                local v1, o1 = Camera:WorldToViewportPoint(p1)
                local v2, o2 = Camera:WorldToViewportPoint(p2)
                if o1 and o2 then
                    local d = (Vector2.new(v1.X, v1.Y) - Vector2.new(v2.X, v2.Y)).Magnitude
                    l.Visible = true; l.Size = UDim2.new(0, d, 0, 1.2); l.BackgroundColor3 = Settings.SkelColor
                    l.Position = UDim2.new(0, (v1.X+v2.X)/2, 0, (v1.Y+v2.Y)/2)
                    l.Rotation = math.deg(math.atan2(v2.Y-v1.Y, v2.X-v1.X))
                else l.Visible = false end
            end

            -- Parça Yakalama (R15 ve R6 Uyumlu)
            local H = char:FindFirstChild("Head")
            local UT = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
            local LT = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso")
            
            -- Kollar
            local LUA = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm")
            local LLA = char:FindFirstChild("LeftLowerArm") or LUA
            local LH = char:FindFirstChild("LeftHand") or LLA
            
            local RUA = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm")
            local RLA = char:FindFirstChild("RightLowerArm") or RUA
            local RH = char:FindFirstChild("RightHand") or RLA
            
            -- Bacaklar
            local LUL = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")
            local LLL = char:FindFirstChild("LeftLowerLeg") or LUL
            local LF = char:FindFirstChild("LeftFoot") or LLL
            
            local RUL = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg")
            local RLL = char:FindFirstChild("RightLowerLeg") or RUL
            local RF = char:FindFirstChild("RightFoot") or RLL

            -- Çizim İşlemleri
            if H and UT then Draw(lines.Neck, H.Position, UT.Position) end
            if UT and LT then Draw(lines.Spine, UT.Position, LT.Position) end
            
            -- Sol Taraf
            if UT and LUA then Draw(lines.L_Shoulder, UT.Position, LUA.Position) end
            if LUA and LLA then Draw(lines.L_Arm, LUA.Position, LLA.Position) end
            if LLA and LH then Draw(lines.L_Hand, LLA.Position, LH.Position) end
            
            -- Sağ Taraf
            if UT and RUA then Draw(lines.R_Shoulder, UT.Position, RUA.Position) end
            if RUA and RLA then Draw(lines.R_Arm, RUA.Position, RLA.Position) end
            if RLA and RH then Draw(lines.R_Hand, RLA.Position, RH.Position) end
            
            -- Alt Gövde
            if LT and LUL then Draw(lines.L_Hip, LT.Position, LUL.Position) end
            if LUL and LLL then Draw(lines.L_Leg, LUL.Position, LLL.Position) end
            if LLL and LF then Draw(lines.L_Foot, LLL.Position, LF.Position) end
            
            if LT and RUL then Draw(lines.R_Hip, LT.Position, RUL.Position) end
            if RUL and RLL then Draw(lines.R_Leg, RUL.Position, RLL.Position) end
            if RLL and RF then Draw(lines.R_Foot, RLL.Position, RF.Position) end
            
        else for _,v in pairs(lines) do v.Visible = false end end
    end)
end

