local function AddToggle(text, key, parent)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(0, 200, 0, 28)
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 10
    Instance.new("UICorner", btn)
    
    local function UpdateText()
        local state = Settings[key]
        btn.Text = string.format("%s: <font color='%s'>%s</font>", text, state and "rgb(0,255,0)" or "rgb(255,0,0)", state and "[ON]" or "[OFF]")
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.RichText = true
    end

    btn.MouseButton1Click:Connect(function()
        if key == "BoxEnabled" then Settings.OutlineEnabled = false
        elseif key == "OutlineEnabled" then Settings.BoxEnabled = false end
        Settings[key] = not Settings[key]
        UpdateText()
    end)
    UpdateText()
end

