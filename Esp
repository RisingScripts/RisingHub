local function ApplyESP(plr)
    local function Setup()
        if plr == LocalPlayer then return end
        local char = plr.Character or plr.CharacterAdded:Wait()
        local root = char:WaitForChild("HumanoidRootPart", 15)
        local hum = char:WaitForChild("Humanoid", 15)
        if not root or not hum then return end

        local box = Instance.new("Frame", ScreenGui)
        local boxStroke = Instance.new("UIStroke", box)
        local nameLabel = Instance.new("TextLabel", ScreenGui)
        local healthLabel = Instance.new("TextLabel", ScreenGui)
        local tracer = Instance.new("Frame", ScreenGui)
        local highlight = Instance.new("Highlight")
        local skelFolder = Instance.new("Folder", ScreenGui)
        
        box.BackgroundTransparency = 1; boxStroke.Thickness = 1.5
        local function Style(l)
            l.BackgroundTransparency = 1; l.Font = Enum.Font.RobotoMono; l.TextStrokeTransparency = 0; l.Visible = false
        end
        Style(nameLabel); Style(healthLabel)
        tracer.BorderSizePixel = 0; tracer.AnchorPoint = Vector2.new(0.5, 0.5); tracer.Visible = false

        AddSkeleton(char, skelFolder)

        local connection
        connection = RunService.RenderStepped:Connect(function()
            if not char or not char.Parent or not root or not hum then
                box:Destroy(); nameLabel:Destroy(); healthLabel:Destroy(); tracer:Destroy(); highlight:Destroy(); skelFolder:Destroy()
                connection:Disconnect(); return
            end

            local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
            
            -- TRACERS ENGINE (Unchanged)
            if Settings.MasterEnabled and hum.Health > 0 and Settings.TracersEnabled then
                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if myRoot then
                    local sPos = Camera:WorldToViewportPoint(myRoot.Position)
                    tracer.Visible = true
                    local targetX, targetY = pos.X, pos.Y
                    if pos.Z < 0 then
                        targetX = Camera.ViewportSize.X - pos.X; targetY = Camera.ViewportSize.Y - pos.Y
                    end
                    local targetPos = Vector2.new(targetX, targetY); local startPos = Vector2.new(sPos.X, sPos.Y)
                    local d = (targetPos - startPos).Magnitude
                    tracer.Size = UDim2.new(0, d, 0, 1); tracer.Position = UDim2.new(0, (startPos.X + targetX) / 2, 0, (startPos.Y + targetY) / 2)
                    tracer.Rotation = math.deg(math.atan2(targetY - startPos.Y, targetX - startPos.X))
                    tracer.BackgroundColor3 = plr.TeamColor.Color
                end
            else tracer.Visible = false end

            -- BOX & TEXT ENGINE (Unchanged)
            if onScreen and Settings.MasterEnabled and hum.Health > 0 then
                local top = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3, 0))
                local bottom = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, -3.5, 0))
                local h = math.abs(top.Y - bottom.Y)
                local w = h * 0.6
                local fontSize = math.clamp(h * 0.05, 10, 14)

                box.Visible = Settings.BoxEnabled; box.Size = UDim2.new(0, w, 0, h); box.Position = UDim2.new(0, pos.X - w/2, 0, pos.Y - h/2); boxStroke.Color = Settings.ESPColor

                nameLabel.Visible = Settings.ShowNames; nameLabel.Text = plr.Name; nameLabel.TextColor3 = plr.TeamColor.Color
                nameLabel.TextSize = fontSize; nameLabel.Position = UDim2.new(0, pos.X - 100, 0, (pos.Y - h/2) - (fontSize + 2))
                nameLabel.Size = UDim2.new(0, 200, 0, 20)

                healthLabel.Visible = Settings.ShowHealth; local hp = math.floor(hum.Health)
                healthLabel.Text = hp .. "%"
                healthLabel.TextColor3 = Color3.fromRGB(255 - (hp * 2.55), hp * 2.55, 0)
                healthLabel.TextSize = fontSize; healthLabel.Position = UDim2.new(0, (pos.X - w/2) - (fontSize * 3.5), 0, pos.Y - 10)
                healthLabel.Size = UDim2.new(0, 50, 0, 20)

                if Settings.OutlineEnabled then
                    if highlight.Parent ~= char then highlight.Parent = char end
                    highlight.Enabled = true; highlight.FillColor = Settings.ESPColor; highlight.OutlineColor = Settings.ESPColor; highlight.FillTransparency = 0.5
                else highlight.Enabled = false end
            else
                box.Visible = false; nameLabel.Visible = false; healthLabel.Visible = false; highlight.Enabled = false
            end
        end)
    end
    Setup(); plr.CharacterAdded:Connect(Setup)
end

for _, p in pairs(Players:GetPlayers()) do ApplyESP(p) end
Players.PlayerAdded:Connect(ApplyESP)

