local function isSelectable(it)
    return it.type ~= "section" and it.type ~= "label"
end

function UI:_wireController()
    local self_ = self
    local ctrl = self.ctrl
    local T = self.T

    function ctrl:render() return self_:_render() end
    function ctrl:updateHL() return self_:_updateHL() end
    function ctrl:updateFooter() return self_:_updateFooter() end
    function ctrl:scrollIntoView() return self_:_scrollIntoView() end
    function ctrl:move(d) return self_:_move(d) end
    function ctrl:open(p)
        p.Parent = p.Parent or self_.current
        self_.current = p
        self_.ctrl.index = 1
        self_:_render()
    end
    function ctrl:back()
        if self_.current.Parent then
            self_.current = self_.current.Parent
            self_.ctrl.index = 1
            self_:_render()
        end
    end
    function ctrl:activate() return self_:_activate() end
    function ctrl:adjust(d) return self_:_adjust(d) end

    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe or not self_.Main.Visible then return end
        if ctrl.listening then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                local kb = ctrl.listening
                ctrl.listening = nil
                kb.key = input.KeyCode
                safe(kb.cb, input.KeyCode)
                self_:_render()
            end
            return
        end
        local k = input.KeyCode
        if k == Enum.KeyCode.Up then ctrl:move(-1)
        elseif k == Enum.KeyCode.Down then ctrl:move(1)
        elseif k == Enum.KeyCode.Return or k == Enum.KeyCode.KeypadEnter then ctrl:activate()
        elseif k == Enum.KeyCode.Right then ctrl:adjust(1)
        elseif k == Enum.KeyCode.Left then ctrl:adjust(-1)
        elseif k == Enum.KeyCode.Backspace then ctrl:back()
        end
    end)
end

function UI:_buildRow(i, it)
    local T = self.T
    local y = (i - 1) * T.RowHeight
    local btn = create("TextButton", {
        Text = "",
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, y),
        Size = UDim2.new(1, 0, 0, T.RowHeight),
        Parent = self.List,
    })
    local hl = create("Frame", {
        BackgroundColor3 = T.Hi,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        BorderSizePixel = 0,
        Parent = btn,
    })
    local accent = create("Frame", {
        Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = T.Accent,
        BorderSizePixel = 0,
        BackgroundTransparency = 1,
        Parent = btn,
    })

    if it.type == "section" then
        create("TextLabel", {
            BackgroundTransparency = 1,
            Text = it.text,
            Font = T.FontBold,
            TextSize = 12,
            TextColor3 = T.Spark,
            TextXAlignment = Enum.TextXAlignment.Left,
            Position = UDim2.new(0, 12, 0, 0),
            Size = UDim2.new(1, -16, 1, 0),
            Parent = btn,
        })
        return { setSel = function() end }
    end

    local lx = 14
    if it.icon then
        create("ImageLabel", {
            BackgroundTransparency = 1,
            Image = "rbxassetid://" .. it.icon,
            ImageColor3 = T.Sub,
            Size = UDim2.new(0, 16, 0, 16),
            Position = UDim2.new(0, 12, 0.5, -8),
            Parent = btn,
        })
        lx = 38
    end
    local label = create("TextLabel", {
        BackgroundTransparency = 1,
        Text = (it.type == "back" and "‹ Back") or it.text,
        Font = T.FontMed,
        TextSize = 13,
        TextColor3 = T.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Position = UDim2.new(0, lx, 0, 0),
        Size = UDim2.new(1, -lx - 150, 1, 0),
        Parent = btn,
    })

    local glyphs = {}
    local function addGlyph(text, xr, w, col, align, keep)
        local t = create("TextLabel", {
            BackgroundTransparency = 1,
            Text = text,
            Font = T.FontBold,
            TextSize = 13,
            TextColor3 = col,
            TextTruncate = Enum.TextTruncate.AtEnd,
            TextXAlignment = align or Enum.TextXAlignment.Center,
            Position = UDim2.new(1, xr, 0, 0),
            Size = UDim2.new(0, w, 1, 0),
            Parent = btn,
        })
        glyphs[#glyphs + 1] = { obj = t, normal = col, keep = keep }
        return t
    end

    if it.type == "submenu" or it.type == "dropopt" then
        addGlyph(">", -22, 14, T.Sub)
    elseif it.type == "toggle" then
        addGlyph(it.state and "ON" or "OFF", -52, 44, it.state and T.On or T.Off, Enum.TextXAlignment.Right, true)
    elseif it.type == "dropdown" then
        addGlyph(tostring(it.options[it.idx] or "-"), -150, 130, T.Spark, Enum.TextXAlignment.Right, true)
        addGlyph(">", -16, 12, T.Sub)
    elseif it.type == "slider" then
        create("TextButton", {
            Text = "‹",
            AutoButtonColor = false,
            BackgroundTransparency = 1,
            Font = T.FontBold,
            TextSize = 16,
            TextColor3 = T.Sub,
            Position = UDim2.new(1, -86, 0, 0),
            Size = UDim2.new(0, 18, 1, 0),
            Parent = btn,
        }).MouseButton1Click:Connect(function()
            self.ctrl.index = i
            self:_updateHL()
            self:_adjust(-1)
        end)
        it._vlab = addGlyph(tostring(it.value), -68, 50, T.Spark)
        create("TextButton", {
            Text = "›",
            AutoButtonColor = false,
            BackgroundTransparency = 1,
            Font = T.FontBold,
            TextSize = 16,
            TextColor3 = T.Sub,
            Position = UDim2.new(1, -20, 0, 0),
            Size = UDim2.new(0, 18, 1, 0),
            Parent = btn,
        }).MouseButton1Click:Connect(function()
            self.ctrl.index = i
            self:_updateHL()
            self:_adjust(1)
        end)
    elseif it.type == "textbox" then
        local boxf = create("Frame", {
            BackgroundColor3 = T.Element,
            BackgroundTransparency = 0.2,
            Size = UDim2.new(0, 90, 0, 22),
            Position = UDim2.new(1, -98, 0.5, -11),
            BorderSizePixel = 0,
            Parent = btn,
        })
        local tb = create("TextBox", {
            BackgroundTransparency = 1,
            Text = it.value or "",
            PlaceholderText = it.placeholder or "...",
            PlaceholderColor3 = T.Sub,
            Font = T.Font,
            TextSize = 12,
            TextColor3 = T.Text,
            Size = UDim2.new(1, -10, 1, 0),
            Position = UDim2.new(0, 6, 0, 0),
            ClearTextOnFocus = false,
            Parent = boxf,
        })
        tb.FocusLost:Connect(function(enter)
            it.value = tb.Text
            safe(it.cb, tb.Text, enter)
        end)
    elseif it.type == "keybind" then
        addGlyph((self.ctrl.listening == it) and "..." or (it.key and it.key.Name or "None"),
            -14, 72, T.Spark, Enum.TextXAlignment.Right, true)
    end

    local function setSel(s)
        hl.BackgroundTransparency = s and 0 or 1
        accent.BackgroundTransparency = s and 0 or 1
        label.TextColor3 = s and T.Dark or T.Text
        for _, g in ipairs(glyphs) do
            if not g.keep then
                g.obj.TextColor3 = s and T.Dark or g.normal
            end
        end
    end
    setSel(false)
    if isSelectable(it) then
        btn.MouseEnter:Connect(function()
            self.ctrl.index = i
            self:_updateHL()
            self:_updateFooter()
        end)
        btn.MouseButton1Click:Connect(function()
            self.ctrl.index = i
            self:_updateHL()
            self:_activate()
        end)
    end
    return { setSel = setSel }
end

function UI:_render()
    local T = self.T
    for _, c in ipairs(self.List:GetChildren()) do
        if c:IsA("GuiButton") then c:Destroy() end
    end
    self.SecLabel.Text = self.current.Name
    self.Crumb.Text = self.current.Parent and "‹ esc" or ""

    local rows = {}
    if self.current.Parent then rows[#rows + 1] = { type = "back" } end
    for _, it in ipairs(self.current.Items) do rows[#rows + 1] = it end
    self.ctrl.rows = rows

    if self.ctrl.index > #rows then self.ctrl.index = #rows end
    if self.ctrl.index < 1 then self.ctrl.index = 1 end
    if rows[self.ctrl.index] and not isSelectable(rows[self.ctrl.index]) then
        for j = 1, #rows do
            if isSelectable(rows[j]) then
                self.ctrl.index = j
                break
            end
        end
    end

    self.ctrl.rowObjs = {}
    for i, it in ipairs(rows) do
        self.ctrl.rowObjs[i] = self:_buildRow(i, it)
    end
    self.List.CanvasSize = UDim2.new(0, 0, 0, #rows * T.RowHeight)
    self.List.ScrollBarThickness = (#rows > T.VisibleRows) and 4 or 0
    self:_updateHL()
    self:_updateFooter()
    self:_scrollIntoView()
end

function UI:_updateHL()
    for i, o in ipairs(self.ctrl.rowObjs) do o.setSel(i == self.ctrl.index) end
end

function UI:_updateFooter()
    self.IndexLbl.Text = string.format("%d / %d", self.ctrl.index, #self.ctrl.rows)
end

function UI:_scrollIntoView()
    local T = self.T
    local LIST_H = T.RowHeight * T.VisibleRows
    local top = (self.ctrl.index - 1) * T.RowHeight
    local cp = self.List.CanvasPosition.Y
    if top < cp then
        cp = top
    elseif top + T.RowHeight > cp + LIST_H then
        cp = top + T.RowHeight - LIST_H
    end
    self.List.CanvasPosition = Vector2.new(0, math.max(cp, 0))
end

function UI:_move(d)
    local n = #self.ctrl.rows
    if n == 0 then return end
    local i = self.ctrl.index
    for _ = 1, n do
        i = ((i - 1 + d) % n) + 1
        if isSelectable(self.ctrl.rows[i]) then break end
    end
    self.ctrl.index = i
    self:_updateHL()
    self:_updateFooter()
    self:_scrollIntoView()
end

function UI:_activate()
    local it = self.ctrl.rows[self.ctrl.index]
    if not it then return end
    if it.type == "back" then
        self.ctrl:back()
    elseif it.type == "submenu" then
        self.ctrl:open(it.target)
    elseif it.type == "button" then
        safe(it.cb)
    elseif it.type == "toggle" then
        it.state = not it.state
        safe(it.cb, it.state)
        self:_render()
    elseif it.type == "slider" then
        self:_adjust(1)
    elseif it.type == "dropdown" then
        local pg = { Name = it.text:upper(), Parent = self.current, Items = {} }
        for vi, opt in ipairs(it.options) do
            pg.Items[#pg.Items + 1] = {
                type = "dropopt",
                text = tostring(opt),
                _drop = it,
                _vi = vi,
            }
        end
        self.ctrl:open(pg)
    elseif it.type == "dropopt" then
        it._drop.idx = it._vi
        safe(it._drop.cb, it._drop.options[it._vi])
        self.ctrl:back()
    elseif it.type == "keybind" then
        if self.ctrl.listening == it then
            self.ctrl.listening = nil
        else
            self.ctrl.listening = it
        end
        self:_render()
    end
end

function UI:_adjust(d)
    local it = self.ctrl.rows[self.ctrl.index]
    if not it then return end
    if it.type == "slider" then
        it.value = math.clamp(it.value + d * it.step, it.min, it.max)
        if it._vlab then it._vlab.Text = tostring(it.value) end
        safe(it.cb, it.value)
    elseif it.type == "submenu" and d > 0 then
        self.ctrl:open(it.target)
    end
end

function UI:AddTab(name, icon, order)
    local page = { Name = tostring(name):upper(), Items = {}, Parent = self.root }
    table.insert(self.root.Items, {
        type = "submenu",
        text = tostring(name),
        target = page,
        icon = icon,
        order = order or 999,
    })
    table.sort(self.root.Items, function(a, b)
        return (a.order or 999) < (b.order or 999)
    end)
    local wrapper = self:_wrapPage(page)
    table.insert(self.tabs, wrapper)
    if self.current == self.root then self:_render() end
    return wrapper
end

function UI:_wrapPage(page)
    local wrapper = {}
    local function add(item)
        table.insert(page.Items, item)
        if self.current == page then self:_render() end
        return item
    end
    function wrapper:AddSection(text)
        add({ type = "section", text = tostring(text) })
    end
    function wrapper:AddButton(text, cb)
        add({ type = "button", text = tostring(text), cb = cb })
    end
    function wrapper:AddToggle(text, default, cb)
        add({ type = "toggle", text = tostring(text), state = default and true or false, cb = cb })
    end
    function wrapper:AddSlider(text, min, max, default, cb)
        local step = math.max(1, math.floor((max - min) / 20 + 0.5))
        add({
            type = "slider",
            text = tostring(text),
            min = min,
            max = max,
            value = math.clamp(default or min, min, max),
            step = step,
            cb = cb,
        })
    end
    function wrapper:AddDropdown(text, options, default, cb)
        local idx = 1
        for i, o in ipairs(options) do if o == default then idx = i end end
        local item = add({
            type = "dropdown",
            text = tostring(text),
            options = options,
            idx = idx,
            cb = cb,
        })
        return function(newOpts)
            item.options = newOpts or {}
            if item.idx > #item.options then item.idx = math.max(1, #item.options) end
            if self.current == page then self:_render() end
        end
    end
    function wrapper:AddTextBox(text, placeholder, cb)
        local item = add({
            type = "textbox",
            text = tostring(text),
            placeholder = placeholder,
            value = "",
            cb = cb,
        })
        return function() return item.value end
    end
    function wrapper:AddKeybind(text, default, cb)
        add({ type = "keybind", text = tostring(text), key = default, cb = cb })
    end
    function wrapper:AddLabel(text)
        add({ type = "section", text = tostring(text) })
    end
    return wrapper
end

function UI:Notify(title, text, duration)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = duration or 3,
        })
    end)
end

return UI
